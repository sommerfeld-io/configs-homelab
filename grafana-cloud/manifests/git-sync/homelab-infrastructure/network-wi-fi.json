{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "wi-fi"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Wi-Fi link quality of the homelab nodes from the node_exporter wifi collector in Alloy: access point, reconnects, signal strength, link bitrates and transmit errors per node and interface.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance, device, ssid, bssid) (node_wifi_station_info{environment=\"homelab\", instance=~\"$instance\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance, device) (node_wifi_interface_frequency_hertz{environment=\"homelab\", instance=~\"$instance\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (instance, device) (node_wifi_station_connected_seconds_total{environment=\"homelab\", instance=~\"$instance\"})",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "merge",
                  "kind": "Transformation",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Value #A": true
                      },
                      "indexByName": {
                        "Value #B": 4,
                        "Value #C": 5,
                        "bssid": 3,
                        "device": 1,
                        "instance": 0,
                        "ssid": 2
                      },
                      "renameByName": {
                        "Value #B": "Frequency",
                        "Value #C": "Connected",
                        "bssid": "BSSID",
                        "device": "Interface",
                        "instance": "Node",
                        "ssid": "SSID"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "Current access point per node and interface: SSID, BSSID (MAC address of the access point), channel frequency and time connected to that access point. Shows the state at the end of the selected time range; a node disconnected at that time is not listed. After a roam, the previous access point is gone with the next scrape.",
          "id": 1,
          "links": [],
          "title": "Connection",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": false,
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  },
                  "noValue": "-",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Frequency"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "hertz"
                      },
                      {
                        "id": "decimals",
                        "value": 2
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Connected"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "s"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "Node"
                  }
                ],
                "zebraStriping": false
              }
            },
            "version": "13.3.0-39387670315"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (instance, device) (resets(node_wifi_station_connected_seconds_total{environment=\"homelab\", instance=~\"$instance\"}[$__range]))",
                        "instant": true,
                        "legendFormat": "{{instance}} {{device}}",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Restarts of the connection time in the selected time range, counted as resets of node_wifi_station_connected_seconds_total (it restarts at 0 on every new association). A reconnect, a node reboot, a Wi-Fi driver reload and a return to an access point used earlier in the range all count. A switch to a new access point starts a new series and is not counted; see BSSID in the Connection table. A drop that is still ongoing at the end of the range is not counted; see Connected time. Very short drops between two scrapes can be missed and show only as a dip in Connected time, if at all.",
          "id": 2,
          "links": [],
          "title": "Reconnects",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 1
                      },
                      {
                        "color": "red",
                        "value": 5
                      }
                    ]
                  },
                  "unit": "none"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            },
            "version": "13.3.0-39387670315"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
